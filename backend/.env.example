NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/courseai
JWT_SECRET=replace-with-a-long-random-secret
GROQ_API_KEY=your-groq-api-key
YOUTUBE_API_KEY=your-youtube-data-api-key
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-public-auth0-client-id

# Provider limits and backpressure controls
GROQ_TPM_LIMIT=8000
GROQ_REASONING_EFFORT=low
AI_QUEUE_CONCURRENCY=2
AI_QUEUE_MAX_SIZE=20
